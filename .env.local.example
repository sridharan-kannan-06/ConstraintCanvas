# Copy this file to .env.local and fill in your key.
# The key is only ever read on the server by src/app/api/agent/route.ts.
# Leave it unset and the app still works: the WebMCP tool surface is
# independent of it, only the built-in agent panel goes quiet.

GEMINI_API_KEY=

# Optional. Tried first, before the built-in fallback list.
# GEMINI_MODEL=gemini-3.8-flash
